<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything that does not need Windows: rules, limits, the send gate and the MCP tools.
       Kept separate so it can be unit-tested on any OS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OutlookClassicMcp</RootNamespace>
    <Version>0.1.0</Version>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

</Project>
